# =====================================================
# College Placement Portal — Environment Configuration
# =====================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =====================================================

# ---- Database ----
# For local PostgreSQL:
DATABASE_URL=jdbc:postgresql://localhost:5432/placement_portal
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# For Supabase (production):
# DATABASE_URL=jdbc:postgresql://db.<project-id>.supabase.co:5432/postgres?sslmode=require
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your-supabase-db-password

# ---- JWT ----
JWT_SECRET=replace-with-a-secure-random-256-bit-key

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Spring Profile ----
# Options: local, dev, prod
SPRING_PROFILES_ACTIVE=local
