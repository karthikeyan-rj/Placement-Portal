SPRING_PROFILES_ACTIVE=prod

DATABASE_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
DATABASE_USERNAME=YOUR_DATABASE_USERNAME
DATABASE_PASSWORD=YOUR_DATABASE_PASSWORD

JWT_SECRET=YOUR_LONG_RANDOM_256_BIT_SECRET

SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# MongoDB (Phase 6F.1 foundation; live messaging still POSTGRES)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=placement_portal
APP_MESSAGING_STORAGE=postgres
APP_MONGODB_ENABLED=false
MIGRATE_MESSAGES_TO_MONGO=false
VALIDATE_MESSAGES_MIGRATION=false
MONGO_PERF_PROBE=false

# Email notifications (Phase 7M.1) - HIGH-importance messages only
APP_EMAIL_NOTIFICATIONS_ENABLED=true
APP_EMAIL_PROVIDER=mock
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=placements@yourdomain.com
RESEND_FROM_NAME=Placement Portal
APP_EMAIL_REPLY_TO=
APP_FRONTEND_URL=http://localhost:5173
EMAIL_BATCH_SIZE=50
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY_BASE_SECONDS=60
EMAIL_WORKER_INTERVAL_MS=2000
